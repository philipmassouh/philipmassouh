philipmassouh.com {
	root * /var/www/philipmassouh.com/html

	@hidden path */.*
	respond @hidden 404

	encode zstd gzip

	# Keep /tabs out of search engines, API responses included.
	@tabs path /tabs /tabs/*
	header @tabs X-Robots-Tag "noindex, nofollow"
	reverse_proxy /tabs/api/* 127.0.0.1:8710

	# Aunt Donna's Wall: family only. DONNA_PASSWORD and the API keys live in
	# /etc/caddy/donna.env (see bootstrap.sh). The page's front door stores the
	# password in a cookie, and every /donna API needs a matching cookie.
	@donna_check {
		path /donna/api/check
		expression `{env.DONNA_PASSWORD} != "" && {http.request.cookie.donna_key} == {env.DONNA_PASSWORD}`
	}
	handle @donna_check {
		respond 204
	}

	@donna_api_locked {
		path /donna/api/*
		not expression `{env.DONNA_PASSWORD} != "" && {http.request.cookie.donna_key} == {env.DONNA_PASSWORD}`
	}
	handle @donna_api_locked {
		respond 401
	}

	@jev {
		path /donna/api/jev
		method POST
		expression `{env.DONNA_PASSWORD} != "" && {http.request.cookie.donna_key} == {env.DONNA_PASSWORD}`
	}
	handle @jev {
		request_body {
			max_size 16KB
		}
		rewrite * /v1/systemone
		reverse_proxy https://api.typesafe.ai {
			header_up Host {upstream_hostport}
			header_up Authorization "Bearer {env.TYPESAFE_API_KEY}"
			header_up -Cookie
		}
	}

	# Trades the Deepgram key for a 30-second token; the browser then
	# streams audio straight to Deepgram with that token.
	@stt {
		path /donna/api/stt-token
		method POST
		expression `{env.DONNA_PASSWORD} != "" && {http.request.cookie.donna_key} == {env.DONNA_PASSWORD}`
	}
	handle @stt {
		request_body {
			max_size 1KB
		}
		rewrite * /v1/auth/grant
		reverse_proxy https://api.deepgram.com {
			header_up Host {upstream_hostport}
			header_up Authorization "Token {env.DEEPGRAM_API_KEY}"
			header_up -Cookie
		}
	}

	file_server
}

www.philipmassouh.com {
	redir https://philipmassouh.com{uri}
}
